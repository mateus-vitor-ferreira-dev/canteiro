# Normaliza fim de linha: o repositório guarda LF, cada sistema recebe o seu.
* text=auto eol=lf

# O mvnw precisa de LF para rodar no Linux/macOS; o .cmd precisa de CRLF no Windows.
mvnw     text eol=lf
*.cmd    text eol=crlf

*.png    binary
*.jpg    binary
*.wav    binary
*.pdf    binary
*.docx   binary
